rules_version = '2';

// Only the accounts listed below can use the app, and each one can only read or write
// its own data under users/{uid}. Nobody can see anyone else's data.
// Replace YOUR_UID with your User UID and HER_UID with the designer's, both from
// Firebase, Authentication, Users. To allow only yourself, delete , "HER_UID".
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == uid
                         && uid in ["YOUR_UID", "HER_UID"];
    }
  }
}
