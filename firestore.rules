rules_version = '2';

// Only your account can read or write your dashboard.
// Replace YOUR_UID with the User UID shown in Firebase, Authentication, Users.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == uid
                         && uid == "YOUR_UID";
    }
  }
}
